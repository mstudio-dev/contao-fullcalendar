{
    "name": "martin-kozianka/contao-fullcalendar",
    "description": "FullCalendar, http://fullcalendar.io for Contao",
    "keywords": [
        "contao",
        "calendar",
        "fullcalendar",
        "ical",
        "ics"
    ],
    "type": "contao-bundle",
    "license": "LGPL-3.0+",
    "authors": [
        {
            "name": "Martin Kozianka",
            "email": "martin@kozianka.de",
            "homepage": "http://kozianka.de",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "martin@kozianka.de",
        "issues": "https://github.com/kozi/contao-fullcalendar/issues",
        "source": "https://github.com/kozi/contao-fullcalendar"
    },
    "autoload": {
        "psr-4": {
            "ContaoFullcalendar\\": "src/ContaoFullcalendar"
        }
    },
    "require": {
        "php": "^8.3",
        "contao/core-bundle": "^5.3",
        "contao/calendar-bundle": "^5.3",
        "contao-community-alliance/composer-plugin": "^3.2",
        "sabre/dav": "^4.7"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao-community-alliance/composer-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "contao-manager-plugin": "ContaoFullcalendar\\ContaoManager\\Plugin"
    }
}
